# docker compose が読む変数。`cp env.example .env` してから値を調整する(.env はコミットしない)。
# 下の値は NVFP4 系の計測(MTP / b12x / aeon 比較)で使ったもの。
# FP8 構成(docker-compose.yml)で使った値は reports/REPORT.md §2.5。
# 実験用 compose の多くはポートや max-model-len などを直書きしており、これらの変数を使わない。

# ホスト側の公開ポート(127.0.0.1 にだけバインドされる)
HOST_PORT=8000
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.44
# docker-compose.yml(FP8)だけが使う。NVFP4 系の compose は 8192 を直書きしている
MAX_NUM_BATCHED_TOKENS=8192

# モデルとキャッシュの置き場所。未設定なら ~/.cache/huggingface と ~/models
# HF_CACHE_DIR=~/.cache/huggingface
# MODELS_DIR=~/models

# 任意: docker-compose.nvfp4.yml の API キー。空なら認証なし
VLLM_API_KEY=

# ---- 以下は compose ではなくベンチスクリプト(bench-datasets/run_*.sh)が読む。シェルで export する ----
# BENCH_IMAGE=vllm-bench:local
# BASE_URL=http://localhost:8000
# MODEL=Qwen/Qwen3.6-35B-A3B
# OPENAI_API_KEY=        # サーバを VLLM_API_KEY 付きで起動したときだけ、同じ値を入れる
